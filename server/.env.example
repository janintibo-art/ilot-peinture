# A créer sur la VM UNIQUEMENT, jamais commiter .env dans GitHub.
API_TOKEN=REMPLACER_PAR_UN_SECRET_DE_48_CARACTERES_AU_MOINS
# Valeur par défaut: accessible uniquement depuis la VM.
